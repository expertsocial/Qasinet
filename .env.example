# ==============================================================================
# QASINET ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.

# ------------------------------------------------------------------------------
# 1. Public App URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://qasinet.vercel.app

# ------------------------------------------------------------------------------
# 2. Resend Email Service (Receipts & Notifications)
# ------------------------------------------------------------------------------
# Enter your Resend API Key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Default Resend sandbox sender (use onboarding@resend.dev until your custom domain is verified)
# Once your domain (e.g. qasinet.com) is verified in Resend, change to: QasiNet <receipts@qasinet.com>
RESEND_FROM_EMAIL=QasiNet <onboarding@resend.dev>


# ------------------------------------------------------------------------------
# 3. M-PESA Daraja API (Safaricom)
# ------------------------------------------------------------------------------
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_PASSKEY=your_daraja_passkey
MPESA_SHORTCODE=4184467
MPESA_TILL_NUMBER=4184501
MPESA_ENVIRONMENT=production
MPESA_INITIATOR_NAME=qasinet
MPESA_INITIATOR_PASSWORD=your_initiator_password

# ------------------------------------------------------------------------------
# 4. Kyanda Vending API
# ------------------------------------------------------------------------------
KYANDA_BASE_URL=https://api.kyanda.app
KYANDA_API_KEY=your_kyanda_api_key
KYANDA_MERCHANT_ID=qasinet
KYANDA_SECURITY_KEY=your_kyanda_security_key
KYANDA_CALLBACK_URL=https://qasinet.vercel.app/api/webhooks/kyanda

# ------------------------------------------------------------------------------
# 4b. Kyanda Pay Bill / Kenya Power (KPLC) Configuration
# ------------------------------------------------------------------------------
# KPLC Channel Codes: Please confirm with Kyanda Support before production launch.
# Common values: KPLC, KPLC_PREPAID, KPLC_POSTPAID
KYANDA_KPLC_PREPAID_CHANNEL=
KYANDA_KPLC_POSTPAID_CHANNEL=

# Kyanda Pay Bill meter field name ('account' or 'phone')
# Defaults to 'account' as per Kyanda documentation Section B.
KYANDA_PAYBILL_ACCOUNT_FIELD=account

# ------------------------------------------------------------------------------
# 4c. Kyanda Merchant Float Pre-Check & Circuit Breaker
# ------------------------------------------------------------------------------
# Set to false to disable pre-flight balance checking (not recommended for production)
FLOAT_CHECK_ENABLED=true

# If Kyanda's balance endpoint errors or times out:
# true  => Fail-Open: allow STK push and rely on VENDING_FAILED_REFUND_PENDING safety net
# false => Fail-Closed: block STK push whenever balance check fails
FLOAT_CHECK_FAIL_OPEN=true

# Flat minimum safety buffer in KES (default: 50)
MIN_FLOAT_BUFFER=50

# Dynamic order safety buffer percentage (default: 5% of order amount)
FLOAT_BUFFER_PERCENT=5

# In-memory balance cache TTL in milliseconds (default: 45000 = 45s)
FLOAT_CACHE_TTL_MS=45000

# ------------------------------------------------------------------------------
# 5. Supabase Database & Auth
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

